 "redact": [
  {
   "id": "jwt",
   "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+"
  },
  {
   "id": "api_key",
   "regex": "\\bsk-[A-Za-z0-9_-]{16,}"
  },
  {
   "id": "pan",
   "regex": "FAKE-PAN-\\d{4}"
  },
  {
   "id": "aadhaar",
   "regex": "(?<![\\d-])(?<!\\d )(?<!\\d-)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?![\\d-])(?! \\d)"
  }
 ],
 "secrets": [
  {
   "id": "jwt",
   "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+"
  },
  {
   "id": "api_key",
   "regex": "sk-[A-Za-z0-9]{16,}"
  },
  {
